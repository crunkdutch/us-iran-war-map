# War Map data pipeline — one full ingest+parse+build+push cycle
[Unit]
Description=US-Iran War Map data pipeline
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/openclaw/.openclaw/workspace/us-iran-war-map
# node/npm live in OpenClaw's toolchain, not /usr/bin; expose them so the
# internal `npm run build` (execSync) resolves too.
Environment=PATH=/home/openclaw/.openclaw/tools/node-v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/openclaw/.openclaw/tools/node-v24.19.0/bin/node /home/openclaw/.openclaw/workspace/us-iran-war-map/pipeline.js
# Long per-step timeouts already handled inside pipeline.js; cap the whole run
TimeoutStartSec=1800
