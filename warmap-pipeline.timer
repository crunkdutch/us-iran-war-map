# Runs the war map pipeline every 2 hours (reduced from 30 min to cut
# Vercel deploy volume; raw HTML is untracked so pushes now happen only
# when parsed data actually changes)
[Unit]
Description=US-Iran War Map pipeline timer

[Timer]
OnBootSec=5min
OnUnitActiveSec=2h
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
